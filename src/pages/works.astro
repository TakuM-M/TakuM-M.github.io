---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { getWorks } from '../lib/works';

// 表示順は この配列の順序
const SECTIONS = [
  { category: 'publication', heading: 'Publications' },
  { category: 'project', heading: 'Projects' },
] as const;

const works = await getWorks();

const entries = await Promise.all(
  works.map(async (work) => {
    const ref = work.data.article;
    const article = ref ? await getEntry(ref) : undefined;
    if (ref && !article) {
      throw new Error(
        `works/${work.id}: article "${ref.id}" が blog コレクションに見つかりません`,
      );
    }
    const { Content } = await render(work);
    // 開発 → 発表 の順に、同じ形式で並べる
    const records = [...work.data.developments, ...work.data.publications];
    return { work, article, Content, records };
  }),
);

const sections = SECTIONS.map((section) => ({
  ...section,
  items: entries.filter(({ work }) => work.data.category === section.category),
})).filter(({ items }) => items.length > 0);
---

<Layout title="Works | Takumi">
  <h1>Works</h1>
  {sections.map(({ heading, items }) => (
    <section class="works-section">
      <h2>{heading}</h2>
      {items.map(({ work, article, Content, records }) => (
        <article id={work.id}>
          <h3>{work.data.title}</h3>
          <Content />
          {records.length > 0 && (
            <ul class="records">
              {records.map((record) => (
                <li>
                  {record.venue && <span class="record-venue">{record.venue}</span>}
                  <span class="record-meta">{record.date} · {record.type}</span>
                  {record.authors && <span class="record-authors">{record.authors}</span>}
                  {record.href && (
                    <a class="record-url" href={record.href} target="_blank" rel="noopener">
                      {record.linkLabel}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}
          {(article || work.data.links.length > 0) && (
            <p class="links">
              {article && <a href={`/blog/${article.id}`}>Blog</a>}
              {work.data.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
              ))}
            </p>
          )}
        </article>
      ))}
    </section>
  ))}
</Layout>
