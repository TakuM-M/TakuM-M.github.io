---
import Layout from '../layouts/Layout.astro';
import { getWorks } from '../lib/works';

const featured = await getWorks({ featuredOnly: true });
---

<Layout title="Takumi">
	<div class="index">
		<dl class="profile">
			<dt>Affiliation</dt>
			<dd>
				Department of Computer Science,<br>
				Graduate School of Systems Design,<br>
				Tokyo Metropolitan University
			</dd>

			<dt>Interests</dt>
			<dd>Recommendation Systems, LLM Agents, Computer Vision</dd>
		</dl>

		<section class="selected">
			<h2>Selected Works</h2>
			<ul>
				{featured.map((work) => (
					<li><a href={`/works#${work.id}`}>{work.data.title}</a></li>
				))}
			</ul>
			<p class="more"><a href="/works">View all works →</a></p>
		</section>
	</div>
</Layout>
